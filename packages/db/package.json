{
  "name": "@app/db",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:schema": "prisma-import --force && prisma generate",
    "format": "eslint . --max-warnings=0 --fix",
    "lint": "eslint . --max-warnings=0",
    "migrate": "pnpm run build:schema > /dev/null 2>&1 && dotenv -e .env -- tsx ./src/migrate/index.ts",
    "test": "dotenv -e .env.test -- prisma migrate reset --force",
    "postinstall": "pnpm run build:schema",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@app/utils": "*",
    "@date-fns/utc": "^1.2.0",
    "@inquirer/prompts": "^5.5.0",
    "@prisma/client": "^5.6.0",
    "@prisma/extension-read-replicas": "^0.3.0",
    "commander": "^12.1.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@app/config": "*",
    "@types/pg": "^8.11.8",
    "prisma": "^5.6.0",
    "prisma-import": "^1.0.5"
  },
  "prisma": {
    "import": {
      "schemas": "schema/models/**/*.prisma",
      "output": "schema/schema.prisma"
    },
    "schema": "schema/schema.prisma"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
